# @conduit/web runtime configuration. Copy to .env.local for `pnpm dev`.
# conduit stores no credentials — it brokers tokens from a running credvault at execution time.

# credvault HTTP API (a running credvault, e.g. its `docker compose up -d` exposes web on :8000).
CONDUIT_CREDVAULT_URL=http://localhost:8000
# The credvault tenant key, held server-side. Treat as a secret; do not commit the real value.
CONDUIT_CREDVAULT_TENANT_KEY=
# Non-secret credvault tenant reference (defaults to verify-acme).
CONDUIT_CREDVAULT_TENANT_REF=verify-acme

# conduit's own Postgres. Unset falls back to an in-memory store (single-process, non-durable).
CONDUIT_DATABASE_URL=postgres://vault:vault@localhost:5432/vault

# OAuth 2.1 issuer / MCP resource origin (must match how clients reach this app).
CONDUIT_PUBLIC_URL=http://localhost:3000
# HS256 signing secret for MCP access tokens. Set a stable value in any real deployment;
# unset means an ephemeral per-process secret (tokens don't survive a restart).
CONDUIT_OAUTH_SIGNING_SECRET=
